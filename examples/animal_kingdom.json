        "DogClone": "Dog",
        "ValueDomain": {
            "directParents": ["Concept"],
            "data": {
                "abstract": true
            }
        },
        "Integer": {
            "directParents": ["ValueDomain"],
            "data": {
                "instantiation": "integer"
            }
        },
        "Duration": {
            "directParents": ["ValueDomain"],
            "data": {
                "instantiation": {
                    "oneOf": [
                        {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 2
                        }, {
                            "type": "integer"
                        }
                    ]
                }
            }
        },
        "String": {
            "directParents": ["ValueDomain"],
