        },
        "CustomFunction": {
            "directParents": ["ValueDomain"],
            "data": {
                "instantiation": {
                    "oneOf": [
                        "FunctionComposition", {
                            "type": "object",
                            "properties": {
                                "interface": {
                                    "type": "object",
                                    "properties": {
                                        "res": { "$ref": "#/$defs/argumentTypeDefinition" }
                                    },
                                    "patternProperties": {
                                        "^[a-z][A-Za-z0-9_]*$": { "$ref": "#/$defs/argumentTypeDefinition" }
                                    }
                                },
                                "procedure": "FunctionComposition"
                            },
                            "required": ["procedure"],
                            "additionalProperties": false
                        }
                    ],
                    "$defs": {
                        "argumentTypeDefinition": {
                            "oneOf": [
                                "TypeName",
                                {
                                    "type": "array",
                                    "items": ["TypeName", "string"],
                                    "minItems": 1,
                                    "maxItems": 2
                                }
                            ]
                        }
                    }
                }
            }
        },
        "FunctionComposition": {
            "directParents": ["ValueDomain"],
            "data": {
                "instantiation": {
                    "type": "object",
                    "additionalProperties": { "type": "object", "properties": "args" },
                    "minProperties": 1, "maxProperties": 1,
                    "propertyNames": {
                        "type": "string", "pattern": "^(fComp:|fEval:|fInst:)?[A-Z][a-zA-Z_0-9]*", "format": "Type", "constraint": "Function"
                    }
                }
            }
        },
        "Function": {
            "directParents": ["ValueDomain"],
