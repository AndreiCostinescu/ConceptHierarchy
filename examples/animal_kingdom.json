        "Add": {
            "directParents": ["FunctionReturning"],
            "data": {
                "templateContext": {
                    "order": ["T"],
                    "T": "Numeric",
                    "substitution": {
                        "FunctionReturning:T": "T"
                    }
                },
                "interface": {
                    "arg1": ["T"],
                    "arg2": ["T"],
                    "res": "T"
                },
                "inversion": [
                    [["Numeric"], { }],
                    [[""], { }]
                ]
            }
        },
