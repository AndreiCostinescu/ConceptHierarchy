        "factorial": {
            "CustomFunction": {
                "interface": {
                    "n": ["s:Integer", "Get"]
                },
                "procedure": {
                    "Condition": {
                        "condition": {
                            "EvaluateRes<Boolean>": {
                                "f": {
                                    "FunctionSequence": {
                                        "fs": [
                                            {
                                                "CreateLocalVariable<Boolean>": {
                                                    "variableName": "s:x",
                                                    "init": true
                                                }
                                            }, {
                                                "Return<Boolean>": {
                                                    "what": {
                                                        "And": {
                                                            "arg1": "x",
                                                            "arg2": {
                                                                "fEval:LessEqual<Integer>": {
                                                                    "arg1": "n",
                                                                    "arg2": 0
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        },
                        "ifTrue": {
                            "Return<Integer>": {
                                "what": 1
                            }
                        },
                        "ifFalse": {
                            "Return<Integer>": {
                                "what": {
                                    "Multiply<Integer>": {
                                        "arg1": "n",
                                        "arg2": {
                                            "EvaluateFunctionRes<Integer>": {
                                                "f": "factorial",
                                                "args": {
                                                    "n": {
                                                        "Subtract<Integer>": {
                                                            "from": "n",
                                                            "what":  1
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
