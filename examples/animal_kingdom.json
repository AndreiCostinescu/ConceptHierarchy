                        "properties": "ConceptParameters",
                        "instanceName": "string"
                    }
                }
            }
        },
        "Instance": {
            "directParents": ["ValueDomain"],
            "data": {
                "templateArguments": {
                    "order": ["AcceptConcepts...", "RejectConcepts..."],
                    "AcceptConcepts": "And(Concept, Not(ValueDomain))",
                    "RejectConcepts": "And(Concept, Not(ValueDomain))",
                    "variadicGroupIdentifiers": {
                        "AcceptConcepts": "",
                        "RejectConcepts": "!"
                    }
                }
            }
        },
        "TypeName": {
            "directParents": ["String"],
            "data": {
                "instantiation": "string"
            }
        },
        "ClosedInterval": {
            "directParents": ["ValueDomain"],
            "data": {
                "templateArguments": {
                    "order": ["T"],
                    "T": "Integer"
                },
                "instantiation": {
                    "type": "object",
                    "properties": {
                        "min": { "type": "T" },
                        "max": { "type": "T" }
                    },
                    "additionalProperties": false
                }
            }
        },
        "Variation": {
            "directParents": ["ValueDomain"],
            "data": {
                "templateArguments": ["T"]
            }
        },
        "SubTypeVariation": {
            "directParents": ["Variation"],
            "data": {
                "templateArguments": {
                    "order": ["SubT", "T"],
                    "SubT": "And(T, Not(T))",
                    "substitution": {
                        "T": "T"
                    }
                }
            }
        },
        "DifferentTemplateArguments": {
            "directParents": ["SubTypeVariation"],
            "data": {
                "templateArguments": {
                    "order": ["First", "Second", "Third"],
                    "Second": "Not(First.)",
                    "Third": "And(Not(First.), Not(Second.))",
                    "substitution": {
                        "T": "First",
                        "SubT": "Second"
                    }
                }
            }
        },
        "CustomFunction": {
            "directParents": ["ValueDomain"],
            "data": {
                "instantiation": {
                    "type": "object",
                    "properties": {
                        "interface": {
                            "type": "object",
                            "properties": {
                                "res": { "$ref": "#/$defs/argumentTypeDefinition" }
                            },
                            "patternProperties": {
                                "^[a-z][A-Za-z0-9_]*$": { "$ref": "#/$defs/argumentTypeDefinition" }
                            }
                        },
                        "procedure": "FunctionComposition"
                    },
                    "required": ["procedure"],
                    "additionalProperties": false,
                    "$defs": {
                        "argumentTypeDefinition": {
                            "oneOf": [
                                "TypeName",
                                {
                                    "type": "array",
                                    "items": ["TypeName", "string"],
                                    "minItems": 1,
                                    "maxItems": 2
                                }
                            ]
                        }
                    }
                }
            }
        },
        "Function": {
            "directParents": ["ValueDomain"],
            "data": {
                "abstract": true
            }
        },
        "FunctionReturning": {
            "directParents": ["Function"],
            "data": {
                "abstract": true,
                "templateArguments": ["T"]
            }
        },
        "Add": {
            "directParents": ["FunctionReturning"],
            "data": {
                "templateArguments": {
                    "order": ["T"],
                    "T": "ValueDomain",
                    "substitution": {
                        "FunctionReturning:T": "T"
                    }
                },
                "interface": {
                    "arg1": ["T"],
                    "arg2": ["T"],
                    "res": "T"
                }
            }
        },
        "Increment": {
            "directParents": ["Add"],
            "data": {
                "templateArguments": {
                    "order": ["T"],
                    "substitution": {
                        "T": "T"
                    }
                },
                "interface": {
                    "_defaultArgumentValues": {
                        "arg2": 1
                    }
                }
            }
        },
        "CreateLocalVariable": {
            "directParents": ["Function"],
            "data": {
                "templateArguments": ["T"],
                "interface": {
                    "varName": "String"
                },
                "addNewVariablesInExistingScope": {
                    "varName": ["T", true]
                }
            }
        }
    },
