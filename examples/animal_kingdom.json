            "directParents": ["Variation"],
            "data": {
                "templateContext": {
                    "order": ["SubT", "T"],
                    "SubT": "And(T, Not(T.))",
                    "substitution": {
                        "T": "T"
                    }
                }
            }
        },
        "DifferentTemplateArguments": {
            "directParents": ["SubTypeVariation"],
            "data": {
                "templateContext": {
                    "order": ["First", "Second", "Third"],
                    "Second": "Not(First.)",
                    "Third": "And(Not(First.), Not(Second.))",
                    "substitution": {
                        "T": "First",
                        "SubT": "Second"
                    }
                }
            }
        },
        "Optional": {
            "directParents": ["ValueDomain"],
            "data": {
