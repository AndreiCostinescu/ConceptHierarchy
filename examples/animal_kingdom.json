                }
            }
        },
        "InstanceData": {
            "directParents": ["ValueDomain"],
            "data": {
                "templateContext": {
                    "order": ["AcceptConcepts..."],
                    "AcceptConcepts": "Not(ValueDomain)"
                },
                "instantiation": {
                    "type": "object",
                    "properties": [["props+(AcceptConcepts...)", "x", true], ["funcs", "x", true]]
                }
            }
        },
