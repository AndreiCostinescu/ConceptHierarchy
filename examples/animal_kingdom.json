                                "res": "s:Number"
                            },
                            "procedure": {
                                "Return<Number>": {
                                    "what": {
                                        "Add<Number>": {
                                            "arg1": "arg",
                                            "arg2": 2
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "_specializations": {
                        "_forThis": {
                            "f1": {
                                "Return<Number>": {
                                    "Add<Number>": {
                                        "arg1": 2,
                                        "arg2": 2
                                    }
                                }
