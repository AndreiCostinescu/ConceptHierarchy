#!/usr/bin/env sh
# .githooks/pre-commit
#
# Local Git hook: rejects commits that contain Python files missing the
# Apache 2.0 license header.
#
# Only checks files that are staged for this commit (new or modified),
# so it won't block you for pre-existing files you haven't touched.
#
# Install for this repo (once):
#   git config core.hooksPath .githooks
#
# The hook looks for this exact line anywhere in the first 20 lines:
#   Licensed under the Apache License, Version 2.0 (the "License");

MISSING=0
MISSING_FILES=""

# Get all staged .py files that are Added (A) or Modified (M).
# Deleted files are excluded — no point checking a file being removed.
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=AM | grep '\.py$')

if [ -z "$STAGED_PY_FILES" ]; then
    # No Python files staged — nothing to check.
    exit 0
fi

for FILE in $STAGED_PY_FILES; do
    # Read the file content from the index (staged version), not from disk.
    # This is important: the staged version may differ from the working tree.
    HEADER=$(git show ":$FILE" 2>/dev/null | head -20)

    if [ $? -ne 0 ]; then
        # File exists in the index but couldn't be read — skip safely.
        continue
    fi

    if ! echo "$HEADER" | grep -q "Licensed under the Apache License, Version 2.0"; then
        MISSING=1
        MISSING_FILES="$MISSING_FILES\n    $FILE"
    fi
done

if [ "$MISSING" -ne 0 ]; then
    echo ""
    echo "ERROR: Commit rejected — missing Apache 2.0 license header."
    echo ""
    echo "The following staged file(s) are missing the license header:"
    printf "$MISSING_FILES"
    echo ""
    echo ""
    echo "Add the following block at the very top of each file:"
    echo ""
    echo "    # Copyright $(date +%Y) ConceptHierarchy Authors"
    echo "    #"
    echo "    # Licensed under the Apache License, Version 2.0 (the \"License\");"
    echo "    # you may not use this file except in compliance with the License."
    echo "    # You may obtain a copy of the License at"
    echo "    #"
    echo "    #     http://www.apache.org/licenses/LICENSE-2.0"
    echo "    #"
    echo "    # Unless required by applicable law or agreed to in writing, software"
    echo "    # distributed under the License is distributed on an \"AS IS\" BASIS,"
    echo "    # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied."
    echo "    # See the License for the specific language governing permissions and"
    echo "    # limitations under the License."
    echo ""
    exit 1
fi

exit 0
